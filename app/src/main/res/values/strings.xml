    <string name="guide_intro_title">3 easy ways to add channels</string>
    <string name="guide_intro_desc">You can build your own live TV library by pasting an M3U link, uploading a playlist file, or picking videos straight from your device gallery. Follow the steps below for the method that works best for you.</string>
    <string name="guide_method_format">Method %1$d: %2$s</string>

    <string name="guide_method_url_title">Add via URL</string>
    <string name="guide_method_url_subtitle">Best for public or provider-issued IPTV links</string>
    <string name="guide_url_step1_title">Open the Add screen</string>
    <string name="guide_url_step1_desc">From the Home screen, tap \"Add new\" (the + button) to open the Add Channel screen.</string>
    <string name="guide_url_step2_title">Select the URL tab</string>
    <string name="guide_url_step2_desc">Make sure the \"URL\" tab is selected at the top of the screen.</string>
    <string name="guide_url_step3_title">Name your playlist</string>
    <string name="guide_url_step3_desc">Enter a name you\'ll recognize later, e.g. \"My Sports Playlist\".</string>
    <string name="guide_url_step4_title">Paste the M3U link</string>
    <string name="guide_url_step4_desc">Paste a link that ends in .m3u or .m3u8, or tap one of the free suggested playlists below the form.</string>
    <string name="guide_url_step5_title">Tap \"Add Playlist\"</string>
    <string name="guide_url_step5_desc">The app downloads and reads the channel list automatically. Once it\'s done, your channels appear on the Home screen.</string>
    <string name="guide_url_tip">Tip: search \"free IPTV M3U playlist\" online, or use sources like iptv-org.github.io to find public links. Make sure you\'re connected to Wi-Fi or mobile data first.</string>

    <string name="guide_method_file_title">Add via File</string>
    <string name="guide_method_file_subtitle">Best for playlist files saved on your device</string>
    <string name="guide_file_step1_title">Open the Add screen</string>
    <string name="guide_file_step1_desc">From the Home screen, tap \"Add new\" (the + button), then switch to the \"File\" tab.</string>
    <string name="guide_file_step2_title">Name your playlist</string>
    <string name="guide_file_step2_desc">Enter a name for this playlist, e.g. \"My Local Channels\".</string>
    <string name="guide_file_step3_title">Upload your file</string>
    <string name="guide_file_step3_desc">Tap the upload box and choose a .m3u or .m3u8 file from your phone\'s storage or downloads.</string>
    <string name="guide_file_step4_title">Or try a sample playlist</string>
    <string name="guide_file_step4_desc">No file handy? Tap one of the ready-made playlists shown below the upload box.</string>
    <string name="guide_file_step5_title">Tap \"Add Playlist\"</string>
    <string name="guide_file_step5_desc">The app reads the file and imports every channel it finds into your library.</string>
    <string name="guide_file_tip">Tip: download an .m3u/.m3u8 file from your IPTV provider\'s website or email using your phone\'s browser first, then import it here.</string>

    <string name="guide_method_gallery_title">Add from Gallery</string>
    <string name="guide_method_gallery_subtitle">Best for your own videos stored on the device</string>
    <string name="guide_gallery_step1_title">Open the Add screen</string>
    <string name="guide_gallery_step1_desc">From the Home screen, tap \"Add new\" (the + button), then switch to the \"Gallery\" tab.</string>
    <string name="guide_gallery_step2_title">Name your playlist</string>
    <string name="guide_gallery_step2_desc">Enter a name for this collection, e.g. \"My Home Videos\".</string>
    <string name="guide_gallery_step3_title">Pick your videos</string>
    <string name="guide_gallery_step3_desc">Tap the card with the + icon to open your device gallery, then select one or more videos.</string>
    <string name="guide_gallery_step4_title">Tap \"Add Playlist\"</string>
    <string name="guide_gallery_step4_desc">All selected videos are saved together as a new playlist you can watch anytime.</string>
    <string name="guide_gallery_tip">Tip: you can select multiple videos at once, and tap the red X on any thumbnail to remove it before saving.</string>

    <string name="guide_after_adding_title">After you add a playlist</string>
    <string name="guide_after_adding_point1">New channels show up on the Home screen and in the Channel tab right away.</string>
    <string name="guide_after_adding_point2">Tap any channel to start watching instantly.</string>
    <string name="guide_after_adding_point3">Tap the heart icon on a channel to save it to Favorites for quick access later.</string>
    <string name="guide_after_adding_point4">You can add as many playlists as you like from different sources — URL, file, or gallery.</string>

    <string name="guide_faq_title">Frequently asked questions</string>
    <string name="guide_faq_q1">The app says \"No channels found\" — what went wrong?</string>
    <string name="guide_faq_a1">The M3U link or file may be empty, expired, or in an unsupported format. Try a different source, or double-check the link opens correctly in a browser first.</string>
    <string name="guide_faq_q2">Why won\'t my URL load?</string>
    <string name="guide_faq_a2">Check your internet connection, and make sure the link starts with http:// or https:// and points directly to an .m3u or .m3u8 file.</string>
    <string name="guide_faq_q3">Can I add more than one playlist?</string>
    <string name="guide_faq_a3">Yes — repeat the steps above as many times as you like. Each playlist is saved separately and all channels appear together on the Home screen.</string>
    <string name="guide_faq_q4">How do I remove a playlist I no longer want?</string>
    <string name="guide_faq_a4">Go to the Channel tab, open the playlist, and use the delete option to remove it from your library.</string>
