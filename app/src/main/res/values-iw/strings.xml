    <string name="intro_title_1">טלוויזיה בשידור חי, בכל מקום שאתה נמצא</string>
    <string name="intro_content_1">ייבא את רשימת ההשמעה של ה-IPTV שלך ותהנה מערוצים חיים בכל מקום שתלך.</string>
    <string name="intro_title_2">התוכן שלך במקום אחד</string>
