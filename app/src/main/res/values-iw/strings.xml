    <string name="add_channel_to_playlist">הוסף ערוץ לפלייליסט</string>
    <string name="guide_intro_title">3 דרכים קלות להוסיף ערוצים</string>
    <string name="guide_intro_desc">אתה יכול לבנות ספריית טלוויזיה חיה משלך על ידי הדבקת קישור M3U, העלאת קובץ פלייליסט או בחירת סרטונים ישירות מגלריית המכשיר שלך. בצע את השלבים הבאים עבור השיטה המתאימה לך ביותר.</string>
    <string name="guide_method_format">שיטה %1$d: %2$s</string>
    <string name="guide_method_url_title">הוסף דרך כתובת אתר</string>
    <string name="guide_method_url_subtitle">הטוב ביותר עבור קישורי IPTV ציבוריים או ספקים</string>
    <string name="guide_url_step1_title">פתח את מסך הוספה</string>
    <string name="guide_url_step1_desc">ממסך הבית, הקש על \"הוסף חדש\" (כפתור ה-+) כדי לפתוח את מסך הוספת ערוץ.</string>
    <string name="guide_url_step2_title">בחר בכרטיסייה URL</string>
    <string name="guide_url_step2_desc">ודא שהכרטיסייה \"URL\" נבחרה בחלק העליון של המסך.</string>
    <string name="guide_url_step3_title">תן שם לרשימת ההשמעה שלך</string>
    <string name="guide_url_step3_desc">הזן שם שתזהה מאוחר יותר, למשל. \"פלייליסט הספורט שלי\".</string>
    <string name="guide_url_step4_title">הדבק את הקישור M3U</string>
    <string name="guide_url_step4_desc">הדבק קישור שמסתיים ב-.m3u או .m3u8, או הקש על אחת מהפלייליסטים המוצעים בחינם מתחת לטופס.</string>
    <string name="guide_url_step5_title">הקש על \"הוסף פלייליסט\"</string>
    <string name="guide_url_step5_desc">האפליקציה מורידה וקוראת את רשימת הערוצים באופן אוטומטי. לאחר שזה יסתיים, הערוצים שלך יופיעו במסך הבית.</string>
    <string name="guide_url_tip">טיפ: חפש \"רשימת השמעה IPTV M3U בחינם\" באינטרנט, או השתמש במקורות כמו iptv-org.github.io כדי למצוא קישורים ציבוריים. תחילה ודא שאתה מחובר ל-Wi-Fi או לנתונים ניידים.</string>
    <string name="guide_method_file_title">הוסף דרך קובץ</string>
    <string name="guide_method_file_subtitle">הטוב ביותר עבור קבצי פלייליסט שנשמרו במכשיר שלך</string>
    <string name="guide_file_step1_title">פתח את מסך הוספה</string>
    <string name="guide_file_step1_desc">ממסך הבית, הקש על \"הוסף חדש\" (כפתור ה-+), ולאחר מכן עבור לכרטיסייה \"קובץ\".</string>
    <string name="guide_file_step2_title">תן שם לרשימת ההשמעה שלך</string>
    <string name="guide_file_step2_desc">הזן שם לפלייליסט הזה, למשל. \"הערוצים המקומיים שלי\".</string>
    <string name="guide_file_step3_title">העלה את הקובץ שלך</string>
    <string name="guide_file_step3_desc">הקש על תיבת ההעלאה ובחר קובץ .m3u או .m3u8 מהאחסון או מההורדות של הטלפון שלך.</string>
    <string name="guide_file_step4_title">או נסה רשימת השמעה לדוגמה</string>
    <string name="guide_file_step4_desc">אין קובץ בהישג יד? הקש על אחת מרשימות ההשמעה המוכנות שמוצגות מתחת לתיבת ההעלאה.</string>
    <string name="guide_file_step5_title">הקש על \"הוסף פלייליסט\"</string>
    <string name="guide_file_step5_desc">האפליקציה קוראת את הקובץ ומייבאת כל ערוץ שהיא מוצאת לספרייה שלך.</string>
    <string name="guide_file_tip">טיפ: הורד תחילה קובץ .m3u/.m3u8 מהאתר של ספק ה-IPTV שלך או מהאימייל באמצעות הדפדפן של הטלפון שלך, ולאחר מכן ייבא אותו לכאן.</string>
    <string name="guide_method_gallery_title">הוסף מהגלריה</string>
    <string name="guide_method_gallery_subtitle">הטוב ביותר עבור סרטונים משלך המאוחסנים במכשיר</string>
    <string name="guide_gallery_step1_title">פתח את מסך הוספה</string>
    <string name="guide_gallery_step1_desc">ממסך הבית, הקש על \"הוסף חדש\" (כפתור ה-+), ולאחר מכן עבור לכרטיסייה \"גלריה\".</string>
    <string name="guide_gallery_step2_title">תן שם לרשימת ההשמעה שלך</string>
    <string name="guide_gallery_step2_desc">הזן שם לאוסף זה, למשל. \"סרטוני הבית שלי\".</string>
    <string name="guide_gallery_step3_title">בחר את הסרטונים שלך</string>
    <string name="guide_gallery_step3_desc">הקש על הכרטיס עם סמל + כדי לפתוח את גלריית המכשיר שלך, ולאחר מכן בחר סרטון אחד או יותר.</string>
    <string name="guide_gallery_step4_title">הקש על \"הוסף פלייליסט\"</string>
    <string name="guide_gallery_step4_desc">כל הסרטונים שנבחרו נשמרים יחד כפלייליסט חדש שתוכלו לצפות בו בכל עת.</string>
    <string name="guide_gallery_tip">טיפ: אתה יכול לבחור מספר סרטונים בו-זמנית, ולהקיש על ה-X האדום בכל תמונה ממוזערת כדי להסיר אותה לפני השמירה.</string>
    <string name="guide_after_adding_title">לאחר הוספת רשימת השמעה</string>
    <string name="guide_after_adding_point1">ערוצים חדשים מופיעים במסך הבית ובכרטיסייה ערוץ מיד.</string>
    <string name="guide_after_adding_point2">הקש על ערוץ כלשהו כדי להתחיל לצפות באופן מיידי.</string>
    <string name="guide_after_adding_point3">הקש על סמל הלב בערוץ כדי לשמור אותו במועדפים לגישה מהירה מאוחר יותר.</string>
    <string name="guide_after_adding_point4">אתה יכול להוסיף כמה רשימות השמעה שתרצה ממקורות שונים - כתובת URL, קובץ או גלריה.</string>
    <string name="guide_faq_title">שאלות נפוצות</string>
    <string name="guide_faq_q1">האפליקציה אומרת \"לא נמצאו ערוצים\" - מה השתבש?</string>
    <string name="guide_faq_a1">הקישור או הקובץ של M3U עשויים להיות ריקים, פג תוקף או בפורמט לא נתמך. נסה מקור אחר, או בדוק תחילה שהקישור נפתח כהלכה בדפדפן.</string>
    <string name="guide_faq_q2">מדוע כתובת האתר שלי לא תיטען?</string>
    <string name="guide_faq_a2">בדוק את חיבור האינטרנט שלך וודא שהקישור מתחיל ב-http:// או https:// ומפנה ישירות לקובץ .m3u או .m3u8.</string>
    <string name="guide_faq_q3">האם אני יכול להוסיף יותר מפלייליסט אחד?</string>
    <string name="guide_faq_a3">כן - חזור על השלבים לעיל כמה פעמים שתרצה. כל רשימת השמעה נשמרת בנפרד וכל הערוצים מופיעים יחד במסך הבית.</string>
    <string name="guide_faq_q4">כיצד אוכל להסיר רשימת השמעה שאינני רוצה יותר?</string>
    <string name="guide_faq_a4">עבור ללשונית ערוץ, פתח את רשימת ההשמעה והשתמש באפשרות המחיקה כדי להסיר אותה מהספרייה שלך.</string>
